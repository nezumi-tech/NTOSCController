<Window x:Class="NanoTerasuOSCController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NT OSC Controller" Height="320" Width="320"
        StateChanged="Window_StateChanged">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="ナノテラス 発光OSC同期" HorizontalAlignment="Center" Margin="0,0,0,15" FontWeight="Bold"/>

        <!-- 自動同期のON/OFFボタン (VRChatのメニューと連動します) -->
        <Button x:Name="BtnToggleAutoSync" Content="自動同期: OFF (手動モード)" Height="35" Margin="0,0,0,10" Click="BtnToggleAutoSync_Click" Background="LightPink" FontWeight="Bold"/>

        <!-- アバター検知状態モニタリング -->
        <TextBlock x:Name="TxtAvatarStatus" Text="アバター状態: 未検知 (着替え・待機中)" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Button Content="手動同期 (今すぐ1回送信)" Height="30" Margin="0,5" Click="BtnSync_Click"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="全点灯 (ALL_ON)" Width="110" Height="30" Margin="5" Click="BtnAllOn_Click"/>
            <Button Content="全消灯 (ALL_OFF)" Width="110" Height="30" Margin="5" Click="BtnAllOff_Click"/>
        </StackPanel>

        <TextBlock x:Name="TxtLastSync" Text="最終同期: 未実行" FontSize="11" Foreground="DarkSlateGray" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        <TextBlock Text="※最小化するとタスクトレイに常駐します" FontSize="10" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
    </StackPanel>
</Window>